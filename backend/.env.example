PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=surveysmart
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Email — for forgot password OTP codes (optional; leave all blank in dev and
# the 6-digit code is printed to the server console instead of emailed).
#
# On Railway use RESEND_API_KEY: Railway blocks outbound SMTP on the
# Free/Trial/Hobby plans, so the MAIL_HOST/SMTP settings below can't deliver
# anything there. Get a key at https://resend.com. With Resend's shared
# sender (onboarding@resend.dev) you can only send to your own account's
# email; verify a domain in Resend to send to everyone.
# If RESEND_API_KEY is set it is used and MAIL_HOST/SMTP is ignored.
RESEND_API_KEY=
# MAIL_FROM is used by both Resend and SMTP, e.g.
#   SurveySmart <no-reply@your-verified-domain.com>
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=your@gmail.com

# Google Forms integration (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Key used to encrypt surveys.google_refresh_token at rest
# (src/utils/credentialCrypto.js). Optional — falls back to JWT_SECRET if
# unset, so this isn't required to add. Set a separate value here if you'd
# rather not have the same secret double as both the JWT signing key and the
# credential-encryption key.
ENCRYPTION_KEY=

# Shared secret the Apps Script webhook must send back (as the
# X-Webhook-Secret header or ?secret= query param) when POSTing responses to
# /api/responses/public/form/:formId. Optional but recommended in production —
# without it, anyone who learns a form's google_form_id can forge submissions.
GOOGLE_FORMS_WEBHOOK_SECRET=
